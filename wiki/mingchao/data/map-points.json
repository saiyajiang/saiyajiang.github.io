group": "传送/入口", "desc": "云陵谷--大世界BOSS挑战——鸣钟之龟快捷信标。\n可在主线任务初期阶段自由探索时解锁该传送信标。"}, {"name": "小型信标", "x": -32281.91, "y": -60920.02, "cId": 1, "group": "传送/入口", "desc": ""}, {"name": "小型信标", "x": 255291.73, "y": 336378.56, "cId": 1, "group": "传送/入口", "desc": "就在这，这个信标放正上方有个踏光兽的皮肤"}, {"name": "小型信标", "x": 200973.63, "y": 300166.81, "cId": 1, "group": "传送/入口", "desc": "前方温泉可提供治疗增益\n（参与潮汐任务 第一幕 第七章 可途径此信标）"}, {"name": "小型信标", "x": 220720.33, "y": 326574.88, "cId": 1, "group": "传送/入口", "desc": "在这里\n（参与潮汐任务 第一幕 第七章 会经过此处信标）"}, {"name": "小型信标", "x": 286745.19, "y": 327916.69, "cId": 1, "group": "传送/入口", "desc": "位于龙头处（完成潮汐任务第七幕时可自动传送至其边上）"}, {"name": "小型信标", "x": 207699.55, "y": 317638.59, "cId": 1, "group": "传送/入口", "desc": "在这"}, {"name": "小型信标", "x": 243105.3, "y": 290362.19, "cId": 1, "group": "传送/入口", "desc": "位于龙身雕像末端，山洞边上"}, {"name": "小型信标", "x": 284487.13, "y": 319002.97, "cId": 1, "group": "传送/入口", "desc": "位于龙形雕像下方隧道处"}, {"name": "小型信标", "x": 268770.84, "y": 306015.31, "cId": 1, "group": "传送/入口", "desc": "首先我们来到红圈标示的卧龙冈小路尽头处（如图一）即可看到眠龙庭入口（如图二），进入山洞后一直前行即可找到信标（如图三）。（完成 潮汐任务 第一章 第七幕 过程中可跟随任务指引经过信标处）"}, {"name": "小型信标", "x": 237353.17, "y": 318847.09, "cId": 1, "group": "传送/入口", "desc": "位于虹镇门口\n（参与潮汐任务 第一幕 第七章 可途径此信标）"}, {"name": "小型信标", "x": -17750.0, "y": 194060.0, "cId": 1, "group": "传送/入口", "desc": "首先来到红圈所标示的小瀑布处(如图1），可在小溪末端发现山洞，进去（如图2），行走一段距离我们就可以看到远处的信标（如图三，ps：看不见在哪的话可以打开地图点击信标并点击追踪，跟随指引走）【无音区位于此信标边上哦】"}, {"name": "小型信标", "x": -2534.04, "y": 314620.78, "cId": 1, "group": "传送/入口", "desc": "画圆的那个小型信标一直往下走"}, {"name": "小型信标", "x": -87247.84, "y": 43431.77, "cId": 1, "group": "传送/入口", "desc": "桃源乡是角色升级材料——金阳凤的生长区域"}, {"name": "小型信标", "x": -12388.31, "y": 73213.0, "cId": 1, "group": "传送/入口", "desc": "此处有村落，还有河滩，风景不错，可作下线前停留地。"}, {"name": "小型信标", "x": -96734.0, "y": 140622.0, "cId": 1, "group": "传送/入口", "desc": "萤泊海区域信标，可从地图龙望郊右下边信标沿路过来。\n路上可见凝素领域挑战（解锁后可传送），记得解锁，龙望郊还有一处红名怪物。"}, {"name": "小型信标", "x": -31086.5, "y": 211824.56, "cId": 1, "group": "传送/入口", "desc": "位于机械